#!/bin/sh
# Versioned reference-transaction hook: no private term reaches a branch.
#
# WHY THIS HOOK AND NOT pre-commit. git commit --no-verify skips pre-commit and
# commit-msg, and a hook cannot see the flag. Every commit, amend, merge,
# rebase and cherry-pick moves a branch through a reference transaction, flag
# or not, so the check lives here. core.hooksPath -> scripts/hooks (make
# install-hooks, and the scaffold for checkouts it creates) is the only
# wiring.
#
# In the "prepared" phase git hands us "<old> <new> <ref>" per update, and a
# non-zero exit aborts the whole transaction. For each refs/heads/* update we
# scan the commits this update brings that are not on any remote: the lines
# each one adds, and its message. For a branch that existed those are
# old..new with no remote-tracking ref holding them; for a new branch, the
# commits of new that no branch and no remote-tracking ref holds. A commit
# already on a remote is not this checkout's to publish, so a pull, a branch
# moved back, or a branch cut from origin/main never blocks on its lines.
# A merge is read as a dense combined diff (--cc): only what it adds beyond
# all of its parents, never what it merged in. A deletion adds nothing. Tags,
# remote-tracking refs, HEAD, stash and rebase bookkeeping refs are skipped.
# A file the update does not touch is never read, so an old line elsewhere in
# the tree never blocks a commit; scripts/private-scan.sh --tree is the
# whole-tree report. An update that brings no commit still runs the scanner,
# on nothing, so a missing list refuses it; a read that fails refuses too.
#
# scripts/private-scan.sh holds the rules: the list's place, what a hit
# prints (path:line and the pattern's number, never the text), and that a
# missing list refuses everything.
[ "${1:-}" = "prepared" ] || exit 0

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
scan="$top/scripts/private-scan.sh"
if [ ! -f "$scan" ]; then
	# A checkout from before the scanner, wired to this hooks folder.
	echo "reference-transaction: $scan is missing; refusing the update" >&2
	exit 1
fi

# plain turns a merge's --cc hunks into the unified form private-scan.sh
# reads. A --cc hunk header has one "@" more than its parents and a marker
# column per parent: a line marked "+" against every parent is added; one
# marked "-" in any column is not in the merge; any other came from a parent
# and is context. A plain patch passes through unchanged.
plain='
/^diff / { n = 0; print; next }
/^@@/ {
	match($0, /^@+/)
	if (RLENGTH == 2) { n = 1; print; next }
	n = RLENGTH - 1
	print "@@ -0,0 " $(n + 2) " @@"
	next
}
n > 1 && /^\\/ { print; next }
n > 1 {
	m = substr($0, 1, n)
	if (m ~ /-/) next
	if (m ~ /^\+*$/) print "+" substr($0, n + 1)
	else print " " substr($0, n + 1)
	next
}
{ print }
'

status=0
while read -r old new ref; do
	case "$ref" in refs/heads/*) ;; *) continue ;; esac
	case "$new" in *[!0]*) ;; *) continue ;; esac
	# The commits this update brings that are not on any remote.
	case "$old" in
	*[!0]*) set -- "$old..$new" --not --remotes ;;
	*) set -- "$new" --not --branches --remotes ;;
	esac
	if ! commits=$(git rev-list "$@") ||
		! patches=$(git log -p --cc --no-color --no-ext-diff --unified=0 --format= "$@"); then
		echo "reference-transaction: cannot read the commits of $ref; refused the update" >&2
		status=1
		continue
	fi
	{
		[ -z "$patches" ] || printf '%s\n' "$patches" | awk "$plain"
		# The message of each new commit travels with it.
		for c in $commits; do
			printf '+++ b/commit %s (message)\n@@ -0,0 +1 @@\n' "$(git rev-parse --short "$c")"
			git log -1 --format=%B "$c" | sed 's/^/+/'
		done
	} | sh "$scan" --diff || {
		echo "reference-transaction: refused the update of $ref" >&2
		status=1
	}
done
exit $status
